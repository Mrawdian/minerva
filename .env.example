# Minerva — environment template. Copy to `.env` and fill with your own keys.
# NEVER commit the real .env (it is gitignored; see .gitignore + SECURITY.md).

# Required for real pipeline runs (Gitee API v5, 5000 req/h)
GITEE_TOKEN=your_gitee_personal_token_here

# Required to generate/translate fiches (Anthropic Claude Haiku)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Optional — raises GitHub collection from 60 to 5000 req/h.
# A read-only classic PAT (no scopes) or fine-grained token with public-repo
# read access is enough. Needed for the full GitHub org harvest.
GITHUB_TOKEN=

# Optional tuning
# MINERVA_LLM_WORKERS=8
